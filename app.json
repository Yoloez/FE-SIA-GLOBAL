{
  "expo": {
    "name": "SIA Global Nusantara",
    "slug": "coba-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/logo-ugn.png",
    "scheme": "cobanativewind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/images/logo-ugn.png",
      "adaptiveIcon": {
        "backgroundColor": "#015023",
        "foregroundImage": "./assets/images/logo-ugn.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO", "android.permission.POST_NOTIFICATIONS"],
      "package": "com.hananfijananto.cobanativewind",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-ugn.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#015023",
          "dark": {
            "image": "./assets/images/logo-ugn.png",
            "backgroundColor": "#015023"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],

      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-ugn.png",
          "color": "#015023",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1d2b90f-3cad-4f8a-bb98-ecff8f68a39f"
      }
    },
    "notification": {
      "icon": "./assets/images/logo-ugn.png",
      "color": "#015023",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notif_count} notifikasi baru"
    }
  }
}
